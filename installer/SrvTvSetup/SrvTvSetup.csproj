<Project Sdk="Microsoft.NET.Sdk">

  <!-- One-file installer for Srv TV. Built on .NET Framework 4.8, which ships
       with Windows 10 and 11, so the setup itself needs nothing installed.
       The app (self-contained) is appended to the exe as a zip payload by
       build-setup.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon>..\..\src\SrvTv\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SrvTvSetup</AssemblyName>
    <RootNamespace>SrvTvSetup</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
