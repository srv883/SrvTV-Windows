<Window x:Class="SrvTv.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Srv TV Player" Background="Black" WindowState="Maximized"
        WindowStyle="None" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <Grid Background="Black">
        <vlc:VideoView x:Name="Video"/>

        <!-- Top info bar -->
        <Border x:Name="InfoBar" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Background="#A6000000" Padding="20,14" Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ChannelName" Text="" Foreground="White"
                               FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="ChannelMeta" Text="" Foreground="#9AA2B0" FontSize="14"/>
                </StackPanel>
                <TextBlock x:Name="Clock" Grid.Column="1" Text="" Foreground="White"
                           FontSize="20" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Controls hint -->
        <TextBlock x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,30" Foreground="#B0FFFFFF" FontSize="13"
                   Text="Esc: back • Hold Esc: exit • F: favorite • A: aspect"/>

        <!-- Buffering pill -->
        <Border x:Name="Buffering" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,96" Background="#CC141A24" CornerRadius="20"
                BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="16,9"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="60" Height="8" VerticalAlignment="Center"/>
                <TextBlock Text="Loading…" Foreground="#C9D4E3" FontSize="13" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Toast -->
        <TextBlock x:Name="Toast" Foreground="White" FontSize="14"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,90"
                   Background="#CC141A24" Padding="14,8" Visibility="Collapsed"/>

        <!-- Exit overlay -->
        <Grid x:Name="ExitOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="#F2161C2B" CornerRadius="20" BorderBrush="#40FFFFFF"
                    BorderThickness="1" Padding="48,32" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Exit Srv TV?" Foreground="White" FontSize="24"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Do you want to exit the app?" Foreground="#9AA2B0"
                               FontSize="16" Margin="0,10,0,28" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnExitNo" Content="No" Width="150" Height="56"
                                FontSize="18" FontWeight="Bold" Margin="0,0,16,0"
                                Click="OnExitNo"/>
                        <Button x:Name="BtnExitYes" Content="Yes" Width="150" Height="56"
                                FontSize="18" FontWeight="Bold" Click="OnExitYes"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
