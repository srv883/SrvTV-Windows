<Window x:Class="SrvTv.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:SrvTv"
        Title="Srv TV Player" Background="Black" WindowState="Maximized"
        WindowStyle="None" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <Grid Background="Black">
        <vlc:VideoView x:Name="Video"/>

        <!-- Top info bar -->
        <Border x:Name="InfoBar" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Background="#A6000000" Padding="20,14" Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ChannelName" Text="" Foreground="White"
                               FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="ChannelMeta" Text="" Foreground="#9AA2B0" FontSize="14"/>
                    <TextBlock x:Name="EpgNowNext" Text="" Foreground="#FFE57F" FontSize="14"/>
                </StackPanel>
                <TextBlock x:Name="Clock" Grid.Column="1" Text="" Foreground="White"
                           FontSize="20" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Controls hint -->
        <TextBlock x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,30" Foreground="#B0FFFFFF" FontSize="13"
                   Text="Up/Down: zap • G: guide • Esc: back • Hold Esc: exit • F: favorite • A: aspect"/>

        <!-- Buffering pill -->
        <Border x:Name="Buffering" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,96" Background="#CC141A24" CornerRadius="20"
                BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="16,9"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="60" Height="8" VerticalAlignment="Center"/>
                <TextBlock Text="Loading…" Foreground="#C9D4E3" FontSize="13" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Toast -->
        <TextBlock x:Name="Toast" Foreground="White" FontSize="14"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,90"
                   Background="#CC141A24" Padding="14,8" Visibility="Collapsed"/>

        <!-- Channel guide drawer (left) -->
        <Border x:Name="GuidePanel" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Width="400" Background="#F0141A26" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="GuideHeader" Text="FAVORITES" Foreground="White" FontSize="20"
                           FontWeight="Bold" Padding="24,16,24,12"/>
                <ListBox x:Name="GuideList" Grid.Row="1" Background="Transparent"
                         BorderThickness="0" Padding="0,0,0,8"
                         MouseDoubleClick="OnGuideDoubleClick"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolVis"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="22,13">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2E0A84FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" Foreground="#FFD600"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <local:AsyncImage Grid.Column="1" Url="{Binding Logo}"
                                                  Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="White"
                                               FontSize="19" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Epg}" Foreground="#FFE57F"
                                               FontSize="13" Visibility="{Binding HasEpg, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Meta}" Foreground="#8E99A9" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="HD" Foreground="#FF9800"
                                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                           Visibility="{Binding IsHd, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Background="#CC000000" Foreground="#B0FFFFFF"
                           FontSize="12" Padding="24,10"
                           Text="Up/Down browse • Left/Right sections • Enter watch • Double-Enter schedule • Esc close"/>
            </Grid>
        </Border>

        <!-- Exit overlay -->
        <Grid x:Name="ExitOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="#F2161C2B" CornerRadius="20" BorderBrush="#40FFFFFF"
                    BorderThickness="1" Padding="48,32" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Exit Srv TV?" Foreground="White" FontSize="24"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Do you want to exit the app?" Foreground="#9AA2B0"
                               FontSize="16" Margin="0,10,0,28" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnExitNo" Content="No" Width="150" Height="56"
                                FontSize="18" FontWeight="Bold" Margin="0,0,16,0"
                                Click="OnExitNo"/>
                        <Button x:Name="BtnExitYes" Content="Yes" Width="150" Height="56"
                                FontSize="18" FontWeight="Bold" Click="OnExitYes"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
