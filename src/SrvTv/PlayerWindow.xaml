<Window x:Class="SrvTv.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:SrvTv"
        Title="Srv TV Player" Background="Black" WindowState="Maximized"
        WindowStyle="None" FontFamily="{StaticResource UiFont}" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <Grid Background="Black">
        <vlc:VideoView x:Name="Video" MouseLeftButtonUp="OnVideoClick"/>

        <!-- Top info bar -->
        <Border x:Name="InfoBar" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Padding="40,26,40,56" Visibility="Visible" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E6000000" Offset="0"/>
                    <GradientStop Color="#99000000" Offset="0.55"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E0FF3B30" CornerRadius="5" Padding="7,2,8,2"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="LIVE" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="ChannelName" Text="" Foreground="White"
                                   FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="ChannelMeta" Text="" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14" Margin="0,6,0,0"/>
                    <TextBlock x:Name="EpgNowNext" Text="" Foreground="#FFE57F" FontSize="14"
                               Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock x:Name="Clock" Grid.Column="1" Text="" Foreground="White"
                           FontSize="22" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- Controls hint -->
        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28" Background="#CC0B0D12" CornerRadius="12" Padding="16,9"
                BorderBrush="#26FFFFFF" BorderThickness="1" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#x2191; &#x2193;" Style="{StaticResource KeyCapText}"/></Border>
                <TextBlock Text="Change channel" Style="{StaticResource HintText}"/>
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="G" Style="{StaticResource KeyCapText}"/></Border>
                <TextBlock Text="Guide" Style="{StaticResource HintText}"/>
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="F" Style="{StaticResource KeyCapText}"/></Border>
                <TextBlock Text="Favorite" Style="{StaticResource HintText}"/>
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="A" Style="{StaticResource KeyCapText}"/></Border>
                <TextBlock Text="Aspect" Style="{StaticResource HintText}"/>
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Esc" Style="{StaticResource KeyCapText}"/></Border>
                <TextBlock Text="Mini player" Style="{StaticResource HintText}"/>
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Hold Esc" Style="{StaticResource KeyCapText}"/></Border>
                <TextBlock Text="Exit" Style="{StaticResource HintText}" Margin="0"/>
            </StackPanel>
        </Border>

        <!-- Buffering pill -->
        <Border x:Name="Buffering" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#CC0B0D12" CornerRadius="14"
                BorderBrush="#26FFFFFF" BorderThickness="1" Padding="20,14"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="Loading&#x2026;" Foreground="White" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <ProgressBar IsIndeterminate="True" Width="140"/>
            </StackPanel>
        </Border>

        <!-- Toast -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,90"
                Background="#E61A1F2B" CornerRadius="10" Padding="16,9" Visibility="Collapsed"
                BorderBrush="#26FFFFFF" BorderThickness="1" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="15"/>
        </Border>

        <!-- Channel guide drawer (left) -->
        <Border x:Name="GuidePanel" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Width="440" Background="{StaticResource Surface0Brush}" Visibility="Collapsed"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="24,22,24,12">
                    <TextBlock Text="CHANNEL GUIDE" Foreground="{StaticResource FocusBlueBrush}" FontSize="11"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="GuideHeader" Text="FAVORITES" Foreground="White" FontSize="22"
                               FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ListBox x:Name="GuideList" Grid.Row="1" Background="Transparent"
                         BorderThickness="0" Padding="10,0,10,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnGuideDoubleClick"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolVis"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="12,11"
                                                CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"
                                                Margin="0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#330A84FF"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBlueBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <local:AsyncImage Grid.Column="1" Url="{Binding Logo}"
                                                  Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="White"
                                               FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Epg}" Foreground="#FFE57F" TextTrimming="CharacterEllipsis"
                                               FontSize="13" Visibility="{Binding HasEpg, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Meta}" Foreground="#8E99A9" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="3" BorderBrush="#99FF9800" BorderThickness="1" CornerRadius="4"
                                        Padding="5,0,5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsHd, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="HD" Foreground="#FFB74D" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                        Padding="24,12">
                    <WrapPanel>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#x2191; &#x2193;" Style="{StaticResource KeyCapText}"/></Border>
                        <TextBlock Text="Browse" Style="{StaticResource HintText}"/>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#x2190; &#x2192;" Style="{StaticResource KeyCapText}"/></Border>
                        <TextBlock Text="Section" Style="{StaticResource HintText}"/>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Enter" Style="{StaticResource KeyCapText}"/></Border>
                        <TextBlock Text="Watch (twice: schedule)" Style="{StaticResource HintText}"/>
                        <Border Style="{StaticResource KeyCap}" Margin="0,6,6,0"><TextBlock Text="Esc" Style="{StaticResource KeyCapText}"/></Border>
                        <TextBlock Text="Close" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Exit overlay -->
        <Grid x:Name="ExitOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface1Brush}" CornerRadius="18" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" Padding="40,30" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Exit Srv TV?" Foreground="White" FontSize="22"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Playback will stop and the app will close." Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14" Margin="0,8,0,24" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnExitNo" Content="Keep watching" Width="160" Height="46"
                                Style="{StaticResource Btn}" FontSize="15" Margin="0,0,12,0"
                                Click="OnExitNo"/>
                        <Button x:Name="BtnExitYes" Content="Exit" Width="160" Height="46"
                                Style="{StaticResource BtnPrimary}" FontSize="15" Click="OnExitYes"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
