<UserControl x:Class="SrvTv.ChannelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="290" Height="168">
    <Border x:Name="Card" CornerRadius="16">
        <Grid>
            <Image x:Name="Logo" Stretch="Uniform" Margin="30,26,30,34"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="FallbackName" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="20,10,20,26"
                       Foreground="White" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="Star" Text="★" Foreground="#FFD600" FontSize="20"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,6,0,0"
                       Visibility="Collapsed"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                    CornerRadius="8" BorderThickness="1" BorderBrush="#66B6FF"
                    Background="#B3102038" Padding="7,2">
                <TextBlock x:Name="Lang" Foreground="#D6E6FF" FontSize="11" FontWeight="Bold"/>
            </Border>
            <TextBlock x:Name="Category" Foreground="#E6EDF3" FontSize="12" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,10">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="Black" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
