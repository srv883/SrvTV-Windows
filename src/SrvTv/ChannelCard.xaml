<UserControl x:Class="SrvTv.ChannelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="290" Height="168" Cursor="Hand"
             MouseLeftButtonUp="OnCardClick">
    <Border x:Name="Card" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid>
            <Image x:Name="Logo" Stretch="Uniform" Margin="30,26,30,34"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="FallbackName" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="20,10,20,26"
                       Foreground="White" FontSize="20" FontWeight="Bold"/>

            <!-- Bottom scrim so the category label reads on bright logos -->
            <Border CornerRadius="0,0,16,16" Height="44" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#73000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Hover glow -->
            <Border x:Name="Glow" CornerRadius="16" BorderBrush="#5AC8FA"
                    BorderThickness="3" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#5AC8FA" Opacity="0.55"/>
                </Border.Effect>
            </Border>

            <!-- Favorite star (clickable) -->
            <Button x:Name="Star" Width="38" Height="38" Style="{StaticResource BtnGhost}"
                    FontSize="24" FontWeight="Normal" Padding="0" Margin="4,4,0,0" Focusable="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center"
                    Click="OnStarClick" ToolTip="Add to / remove from Favorites (F)"/>

            <!-- Playing now chip -->
            <Border x:Name="NowChip" Visibility="Collapsed" CornerRadius="8"
                    Background="#E60A84FF" BorderBrush="#8040C0FF" BorderThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48,8,0,0"
                    Padding="8,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text=" NOW" Foreground="White" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Offline chip -->
            <Border x:Name="OffChip" Visibility="Collapsed" CornerRadius="8"
                    Background="#C0000000" BorderBrush="#80FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8"
                    Padding="8,3" IsHitTestVisible="False">
                <TextBlock Text="OFF" Foreground="#FF8A80" FontSize="11" FontWeight="Bold"/>
            </Border>

            <Border x:Name="LangPill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                    CornerRadius="8" BorderThickness="1" BorderBrush="#66B6FF"
                    Background="#B3102038" Padding="7,2">
                <TextBlock x:Name="Lang" Foreground="#D6E6FF" FontSize="11" FontWeight="Bold"/>
            </Border>
            <TextBlock x:Name="Category" Foreground="#E6EDF3" FontSize="12" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,10">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="Black" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Play chip shown on hover -->
            <Border x:Name="PlayChip" Visibility="Collapsed" CornerRadius="20"
                    Background="#D9000000" BorderBrush="#B0FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,8"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▶" Foreground="#5AC8FA" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  Watch" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="CtxPlay" Header="Watch" Click="OnCtxPlay"/>
                <MenuItem x:Name="CtxFav" Header="Add to Favorites" Click="OnCtxFav"/>
                <Separator/>
                <MenuItem Header="Copy stream URL" Click="OnCtxCopy"/>
                <MenuItem Header="Search for this channel" Click="OnCtxSearch"/>
            </ContextMenu>
        </Border.ContextMenu>
    </Border>
</UserControl>