<Window x:Class="SrvTv.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SrvTv"
        Title="Search · Srv TV" Height="720" Width="860" MinWidth="560" MinHeight="420"
        Background="{StaticResource AppBackground}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="28,24,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- Search field with icon and placeholder -->
        <Grid>
            <TextBox x:Name="Query" Style="{StaticResource Field}" FontSize="20" Padding="44,11,14,11"
                     TextChanged="OnQueryChanged"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                       Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="17,0,0,0"/>
            <TextBlock x:Name="Placeholder" Text="Channel name, language or category"
                       Foreground="{StaticResource TextFaintBrush}" FontSize="20" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="47,0,0,1"/>
        </Grid>

        <TextBlock x:Name="ResultCount" Grid.Row="1" Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12" Margin="4,14,0,8"/>

        <ListBox x:Name="Results" Grid.Row="2" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource Row}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 MouseDoubleClick="OnPick" PreviewKeyDown="OnResultsKey">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="40" CornerRadius="8" Background="#141821"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <local:AsyncImage Url="{Binding Logo}" Width="48" Height="34"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Category, Converter={StaticResource Label}}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#1FFFFFFF" CornerRadius="6" Padding="8,2"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Language, Converter={StaticResource Label}}" Foreground="#D6E6FF" FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="NoResults" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="No channels match" Foreground="White" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Try a shorter name, or a language like Hindi or Tamil."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#x2191; &#x2193;" Style="{StaticResource KeyCapText}"/></Border>
            <TextBlock Text="Choose" Style="{StaticResource HintText}"/>
            <Border Style="{StaticResource KeyCap}"><TextBlock Text="Enter" Style="{StaticResource KeyCapText}"/></Border>
            <TextBlock Text="Watch" Style="{StaticResource HintText}"/>
            <Border Style="{StaticResource KeyCap}"><TextBlock Text="Esc" Style="{StaticResource KeyCapText}"/></Border>
            <TextBlock Text="Clear / close" Style="{StaticResource HintText}"/>
        </StackPanel>
    </Grid>
</Window>
