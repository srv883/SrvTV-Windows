<Window x:Class="SrvTv.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SrvTv"
        Title="Search" Height="700" Width="900" Background="{StaticResource AppBackground}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="Query" FontSize="22" Padding="14,10" Margin="0,0,0,16"
                 Background="#1C2330" Foreground="White" CaretBrush="White"
                 TextChanged="OnQueryChanged" BorderThickness="0"/>
        <ListBox x:Name="Results" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 MouseDoubleClick="OnPick" PreviewKeyDown="OnResultsKey">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NoFocusRect}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="14,10"/>
                    <Setter Property="FontSize" Value="18"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0A84FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Name}"/> <Run Text="  •  " Foreground="#9AA2B0"/><Run Text="{Binding Category}" Foreground="#9AA2B0"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
