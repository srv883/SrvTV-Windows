<Window x:Class="SrvTv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SrvTv"
        xmlns:vw="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Srv TV" Height="900" Width="1500" MinHeight="600" MinWidth="900"
        Background="{StaticResource AppBackground}" WindowState="Maximized"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#141821" Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="#1C2330"
                            BorderBrush="#5AC8FA" BorderThickness="1" Margin="0,0,16,0">
                        <TextBlock Text="📺" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Srv " Foreground="White" FontFamily="Georgia" FontSize="26"/>
                            <TextBlock Text="TV" Foreground="#5AC8FA" FontFamily="Georgia" FontSize="26"/>
                        </StackPanel>
                        <TextBlock x:Name="ChannelCount" Text="0 channels" Foreground="#9AA2B0" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockTime" Text="--:--" Foreground="White"
                               FontFamily="Georgia" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ClockDate" Text="------" Foreground="#9AA2B0"
                               FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSearch" Content="🔍 Search" Click="OnSearch"
                            Margin="0,0,12,0" Padding="16,10" FontSize="15"/>
                    <Button x:Name="BtnRefresh" Content="⟳ Refresh" Click="OnRefresh"
                            Margin="0,0,12,0" Padding="16,10" FontSize="15"/>
                    <Button x:Name="BtnSettings" Content="⚙ Settings" Click="OnSettings"
                            Padding="16,10" FontSize="15"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Category rail -->
        <ListBox x:Name="Rail" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 Padding="28,10" ItemContainerStyle="{StaticResource Pill}"
                 SelectionChanged="OnRailSelected">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        <Border Background="#3A3F4B" CornerRadius="10" Margin="10,0,0,0"
                                Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChannelCount}" FontSize="13" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Channel grid -->
        <ListBox x:Name="Grid" Grid.Row="2" Background="Transparent" BorderThickness="0"
                 Margin="22,0,22,14" SelectionMode="Single"
                 MouseDoubleClick="OnGridDoubleClick"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vw:VirtualizingWrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NoFocusRect}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="20"
                                        Padding="{TemplateBinding Padding}" BorderThickness="3">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#5AC8FA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:ChannelCard/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Loading overlay -->
        <Border x:Name="Loading" Grid.RowSpan="3" Background="#99000000" Visibility="Visible"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="10"/>
                <TextBlock x:Name="LoadingText" Text="Loading channels..."
                           Foreground="White" FontSize="16" Margin="0,14,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mini PiP (top-right corner) -->
        <Border x:Name="PipFrame" Width="240" Height="135" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                CornerRadius="10" BorderBrush="#5AC8FA" BorderThickness="1" Background="Black">
            <Grid>
                <vlc:VideoView x:Name="MiniView"/>
                <Button Content="✕" Width="30" Height="30" FontSize="13" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                        Click="OnPipClose"/>
            </Grid>
        </Border>

        <!-- Toast -->
        <TextBlock x:Name="Toast" Grid.Row="2" Foreground="White" FontSize="14"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,24"
                   Background="#CC141A24" Padding="14,8" Visibility="Collapsed"/>

        <!-- Exit overlay -->
        <Grid x:Name="ExitOverlay" Grid.RowSpan="3" Background="#B3000000" Visibility="Collapsed">
            <Border Background="#F2161C2B" CornerRadius="20" BorderBrush="#40FFFFFF"
                    BorderThickness="1" Padding="48,32" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Exit Srv TV?" Foreground="White" FontSize="24"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Do you want to exit the app?" Foreground="#9AA2B0"
                               FontSize="16" Margin="0,10,0,28" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnExitNo" Content="No" Width="150" Height="56"
                                FontSize="18" FontWeight="Bold" Margin="0,0,16,0"
                                Click="OnExitNo"/>
                        <Button x:Name="BtnExitYes" Content="Yes" Width="150" Height="56"
                                FontSize="18" FontWeight="Bold" Click="OnExitYes"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
