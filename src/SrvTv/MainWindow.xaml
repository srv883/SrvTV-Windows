<Window x:Class="SrvTv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SrvTv"
        xmlns:vw="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Srv TV" Height="900" Width="1500" MinHeight="600" MinWidth="900"
        Background="{StaticResource AppBackground}" WindowState="Maximized"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A84FF" Offset="0"/>
                                <GradientStop Color="#5AC8FA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="19"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Srv " Foreground="White" FontFamily="{StaticResource BrandFont}" FontSize="22"/>
                            <TextBlock Text="TV" Foreground="{StaticResource FocusBlueBrush}" FontFamily="{StaticResource BrandFont}" FontSize="22"/>
                        </StackPanel>
                        <TextBlock x:Name="ChannelCount" Text="0 channels"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Clock -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockTime" Text="--:--" Foreground="White"
                               FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ClockDate" Text="------" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnSearch" Click="OnSearch" Style="{StaticResource Btn}"
                            Height="42" Padding="14,0" Margin="0,0,10,0" ToolTip="Search channels (Ctrl+F)"
                            Background="{StaticResource Surface0Brush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Search channels" Margin="10,0,36,0" FontWeight="Normal"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyCap}" Margin="0">
                                <TextBlock Text="Ctrl F" Style="{StaticResource KeyCapText}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRefresh" Click="OnRefresh" Style="{StaticResource BtnIcon}"
                            Content="&#xE72C;" Margin="0,0,10,0" ToolTip="Refresh channel lists"/>
                    <Button x:Name="BtnSettings" Click="OnSettings" Style="{StaticResource BtnIcon}"
                            Content="&#xE713;" ToolTip="Settings"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Category rail ===== -->
        <ListBox x:Name="Rail" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 Padding="24,12,24,8" ItemContainerStyle="{StaticResource Pill}"
                 VerticalContentAlignment="Center"
                 SelectionChanged="OnRailSelected">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ChannelCount}" FontSize="12" FontWeight="Normal"
                                   Opacity="0.7" Margin="8,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== Channel grid ===== -->
        <ListBox x:Name="Grid" Grid.Row="2" Background="Transparent" BorderThickness="0"
                 Margin="18,4,8,0" SelectionMode="Single"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vw:VirtualizingWrapPanel SpacingMode="BetweenItemsOnly"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NoFocusRect}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="20"
                                        Padding="{TemplateBinding Padding}" BorderThickness="3"
                                        BorderBrush="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBlueBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:ChannelCard/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty section message -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="40"
                       Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyTitle" Text="Nothing here yet" Foreground="White" FontSize="20"
                       FontWeight="SemiBold" Margin="0,14,0,6" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyText" Text="Star a channel with F or the ★ on its card to add it to Favorites."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ===== Bottom bar: toast + key hints ===== -->
        <Border Grid.Row="3" Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="28,0">
            <Grid>
                <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Background="{StaticResource Surface3Brush}"
                        CornerRadius="8" Padding="12,4">
                    <TextBlock x:Name="ToastText" Foreground="White" FontSize="13"/>
                </Border>
                <StackPanel x:Name="Hints" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Enter" Style="{StaticResource KeyCapText}"/></Border>
                    <TextBlock Text="Watch" Style="{StaticResource HintText}"/>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="F" Style="{StaticResource KeyCapText}"/></Border>
                    <TextBlock Text="Favorite" Style="{StaticResource HintText}"/>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="← →" Style="{StaticResource KeyCapText}"/></Border>
                    <TextBlock Text="Move / next section" Style="{StaticResource HintText}"/>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="PgUp PgDn" Style="{StaticResource KeyCapText}"/></Border>
                    <TextBlock Text="Page" Style="{StaticResource HintText}"/>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl F" Style="{StaticResource KeyCapText}"/></Border>
                    <TextBlock Text="Search" Style="{StaticResource HintText}"/>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Esc" Style="{StaticResource KeyCapText}"/></Border>
                    <TextBlock Text="Exit" Style="{StaticResource HintText}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Loading overlay ===== -->
        <Grid x:Name="Loading" Grid.RowSpan="4" Background="#B3060709" Visibility="Visible">
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="36,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Width="260">
                    <TextBlock x:Name="LoadingText" Text="Loading channels..."
                               Foreground="White" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Mini PiP (top-right corner) ===== -->
        <Border x:Name="PipFrame" Grid.RowSpan="3" Width="288" Height="162" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,16"
                CornerRadius="12" BorderBrush="{StaticResource FocusBlueBrush}" BorderThickness="2"
                Background="Black" MouseLeftButtonUp="OnPipResume" Cursor="Hand"
                ToolTip="Click to go back to full screen">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <Grid>
                <vlc:VideoView x:Name="MiniView" IsHitTestVisible="False"/>
                <Button Content="&#xE711;" Style="{StaticResource BtnIcon}" Width="30" Height="30"
                        FontSize="11" Background="#CC12151D" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,6,6,0" Click="OnPipClose"
                        ToolTip="Stop and close"/>
            </Grid>
        </Border>

        <!-- ===== Exit overlay ===== -->
        <Grid x:Name="ExitOverlay" Grid.RowSpan="4" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface1Brush}" CornerRadius="18"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="40,30"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Exit Srv TV?" Foreground="White" FontSize="22"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Anything playing in the mini player will stop."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14" Margin="0,8,0,24" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnExitNo" Content="Stay" Width="140" Height="46"
                                Style="{StaticResource Btn}" FontSize="15" Margin="0,0,12,0"
                                Click="OnExitNo"/>
                        <Button x:Name="BtnExitYes" Content="Exit" Width="140" Height="46"
                                Style="{StaticResource BtnPrimary}" FontSize="15" Click="OnExitYes"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
