<Window x:Class="SrvTv.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings · Srv TV" Height="600" Width="720" MinWidth="520" MinHeight="460"
        Background="{StaticResource AppBackground}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" VerticalAlignment="Top">
            <TextBlock Text="Settings" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <!-- Channel lists -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Channel lists" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Download every playlist again and rebuild the sections."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="Status" Text="" Foreground="{StaticResource FocusBlueBrush}"
                                   FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="BtnRefresh" Grid.Column="1" Style="{StaticResource BtnPrimary}"
                            Content="Refresh now" VerticalAlignment="Center" Click="OnRefresh"/>
                </Grid>
            </Border>

            <!-- Favorites import -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Import favorites from the TV app" Foreground="White" FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Paste the favorites JSON array from the Android app's iptv_prefs.xml, then Import."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,12"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="FavJson" Style="{StaticResource Field}" Height="120" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12"
                             FontFamily="Cascadia Mono, Consolas"/>
                    <Button Content="Import" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Click="OnImport"/>
                </StackPanel>
            </Border>

            <!-- Troubleshooting -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Troubleshooting" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Logs show what each channel tried when it would not play."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Open log folder"
                            VerticalAlignment="Center" Click="OnLogFolder"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
